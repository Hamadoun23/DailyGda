APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# En production : URL complète du site (ex. https://mondomaine.com ou https://mondomaine.com/dailygda/public)
# ASSET_URL=  # Optionnel : même base que les fichiers publics si l'app est dans un sous-dossier

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Domaines autorisés pour les cookies Sanctum (galerie photos, API session)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:8000
# Production : SANCTUM_STATEFUL_DOMAINS=mondomaine.com,www.mondomaine.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Après déploiement : php artisan storage:link
# Copier aussi storage/app/public/ (photos uploadées) depuis le serveur local si besoin.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Galerie photos — limites Laravel (Ko). 65536 = 64 Mo (aligné sur upload_max_filesize PHP)
GDA_PHOTO_MAX_KB=65536
# Compression serveur seulement au-dessus de 8 Mo
GDA_PHOTO_COMPRESS_BYTES=8388608

# Météo barre de navigation (OpenWeatherMap) — ne pas commiter la vraie clé
# Après ajout en prod : php artisan config:clear
OPENWEATHER_API_KEY=
# GDA_WEATHER_LAT=12.6392
# GDA_WEATHER_LON=-8.0029
# Seuils alertes prévisions (vent m/s, probabilité pluie 0–1, mm/3h)
# GDA_WEATHER_WIND_ALERT_MS=10
# GDA_WEATHER_RAIN_POP_ALERT=0.55
# GDA_WEATHER_RAIN_MM_ALERT=1.0

# Traduction auto FR→EN des commentaires / descriptions libres (nécessite Internet)
GDA_AUTO_TRANSLATE=true
